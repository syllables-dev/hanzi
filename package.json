{
  "name": "@syllables-dev/hanzi",
  "version": "0.1.0",
  "description": "Simplified and Traditional Chinese script detection and conversion.",
  "license": "UNLICENSED",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./detect": {
      "types": "./dist/detect.d.ts",
      "import": "./dist/detect.js"
    },
    "./hans": {
      "types": "./dist/hans.d.ts",
      "import": "./dist/hans.js"
    },
    "./hant": {
      "types": "./dist/hant.d.ts",
      "import": "./dist/hant.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepublishOnly": "bun run build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "bun test",
    "tsgo": "tsgo --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/bun": "latest",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "ultracite": "7.10.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syllables-dev/hanzi.git"
  }
}
